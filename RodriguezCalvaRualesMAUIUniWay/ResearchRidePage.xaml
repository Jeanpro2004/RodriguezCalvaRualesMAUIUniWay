<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:RodriguezCalvaRualesMAUIUniWay.API"
             x:Class="RodriguezCalvaRualesMAUIUniWay.Views.SearchRidePage"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Título -->
            <Label Text="Buscar Viaje" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#2C3E50"
                   Margin="0,20,0,0"/>

            <!-- Formulario -->
            <Frame BackgroundColor="#F8F9FA" CornerRadius="15" Padding="20" HasShadow="True">
                <VerticalStackLayout Spacing="15">

                    <!-- Origen -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Desde" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                        <Frame BackgroundColor="White" CornerRadius="10" Padding="0" HasShadow="False" BorderColor="#E0E0E0">
                            <Entry x:Name="OriginEntry"
                                   Placeholder="¿Desde dónde sales?"
                                   PlaceholderColor="#95A5A6"
                                   TextColor="#2C3E50"
                                   BackgroundColor="Transparent"
                                   Margin="15,0"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Destino -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Hacia" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                        <Frame BackgroundColor="White" CornerRadius="10" Padding="0" HasShadow="False" BorderColor="#E0E0E0">
                            <Entry x:Name="DestinationEntry"
                                   Placeholder="¿A dónde vas?"
                                   PlaceholderColor="#95A5A6"
                                   TextColor="#2C3E50"
                                   BackgroundColor="Transparent"
                                   Margin="15,0"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Fecha -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Fecha del viaje" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                        <Frame BackgroundColor="White" CornerRadius="10" Padding="0" HasShadow="False" BorderColor="#E0E0E0">
                            <DatePicker x:Name="TravelDatePicker"
                                       TextColor="#2C3E50"
                                       BackgroundColor="Transparent"
                                       Margin="15,0"
                                       Format="dd/MM/yyyy"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Pasajeros -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Número de pasajeros" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                        <Frame BackgroundColor="White" CornerRadius="10" Padding="0" HasShadow="False" BorderColor="#E0E0E0">
                            <Picker x:Name="PassengersPicker"
                                    Title="Selecciona"
                                    TitleColor="#95A5A6"
                                    TextColor="#2C3E50"
                                    BackgroundColor="Transparent"
                                    Margin="15,0">
                                <Picker.Items>
                                    <x:String>1 pasajero</x:String>
                                    <x:String>2 pasajeros</x:String>
                                    <x:String>3 pasajeros</x:String>
                                    <x:String>4 pasajeros</x:String>
                                </Picker.Items>
                            </Picker>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Botón de búsqueda -->
                    <Button x:Name="SearchButton"
                            Text="🔍 Buscar Viajes"
                            BackgroundColor="#8B0000"
                            TextColor="White"
                            CornerRadius="25"
                            HeightRequest="50"
                            FontSize="16"
                            FontAttributes="Bold"
                            Margin="0,10,0,0"
                            Clicked="OnSearchClicked"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Resultados -->

            <!-- Texto si no hay resultados -->
            <Label x:Name="EmptyLabel"
                   IsVisible="False"
                   Text="No se encontraron viajes 😔"
                   TextColor="#2C3E50"
                   FontSize="14"
                   HorizontalOptions="Center"
                   Margin="0,10,0,0"/>

            <!-- Lista de resultados -->
            <CollectionView x:Name="ResultsCollection"
                            IsVisible="False"
                            Margin="0,10,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Viaje">
                        <Frame BackgroundColor="#F0F8FF"
                               CornerRadius="12"
                               Padding="12"
                               HasShadow="False"
                               Margin="0,0,0,10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Origen} → {Binding Destino}"
                                       FontAttributes="Bold"
                                       TextColor="#2C3E50"/>
                                <Label Text="{Binding FechaHoraSalida, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                       FontSize="12"
                                       TextColor="#2C3E50"/>
                                <Label Text="{Binding Precio, StringFormat='${0:F2}'}"
                                       FontSize="12"
                                       TextColor="#2C3E50"/>
                                <Label Text="{Binding AsientosDisponibles, StringFormat='Asientos disponibles: {0}'}"
                                       FontSize="12"
                                       TextColor="#2C3E50"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Rutas populares -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Rutas populares" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       TextColor="#2C3E50"/>

                <CollectionView x:Name="PopularRoutesCollection" HeightRequest="120">
                    <CollectionView.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>🏛️ UDLA PARK → UDLA ARENA</x:String>
                            <x:String>🏠 UDLA ARENA → UDLA GRANADOS</x:String>
                            <x:String>🚌 UDLA GRANADOS → UDLA COLON</x:String>
                            <x:String>🏢 UDLA PARK → UDLA COLON</x:String>
                        </x:Array>
                    </CollectionView.ItemsSource>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10">
                                <Frame BackgroundColor="#F0F8FF" CornerRadius="8" Padding="10" HasShadow="False">
                                    <Label Text="{Binding .}" 
                                           TextColor="#2C3E50" 
                                           FontSize="14"
                                           VerticalOptions="Center"/>
                                </Frame>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
