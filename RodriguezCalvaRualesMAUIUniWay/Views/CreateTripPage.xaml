<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             x:Class="RodriguezCalvaRualesMAUIUniWay.Views.CreateTripPage"
             BackgroundColor="#F8F9FA"
             Title="Crear Viaje">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header Section -->
            <Frame BackgroundColor="White" 
                   CornerRadius="15" 
                   HasShadow="True"
                   Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🚗" 
                           FontSize="40" 
                           HorizontalOptions="Center" />
                    <Label Text="Crear nuevo viaje"
                           FontSize="26"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#2C3E50" />
                    <Label Text="Completa la información de tu viaje"
                           FontSize="14"
                           HorizontalOptions="Center"
                           TextColor="#7F8C8D" />
                </VerticalStackLayout>
            </Frame>

            <!-- Route Information -->
            <Frame BackgroundColor="White" 
                   CornerRadius="15" 
                   HasShadow="True"
                   Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="📍 Información de Ruta"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#34495E" />

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Origen" 
                               FontSize="14" 
                               TextColor="#7F8C8D"
                               FontAttributes="Bold" />
                        <Frame BackgroundColor="#F8F9FA" 
                               CornerRadius="10" 
                               Padding="0"
                               HasShadow="False">
                            <Entry x:Name="OrigenEntry"
                                   Placeholder="Ingresa el lugar de origen"
                                   TextColor="#2C3E50"
                                   BackgroundColor="Transparent"
                                   FontSize="16" />
                        </Frame>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Destino" 
                               FontSize="14" 
                               TextColor="#7F8C8D"
                               FontAttributes="Bold" />
                        <Frame BackgroundColor="#F8F9FA" 
                               CornerRadius="10" 
                               Padding="0"
                               HasShadow="False">
                            <Entry x:Name="DestinoEntry"
                                   Placeholder="Ingresa el lugar de destino"
                                   TextColor="#2C3E50"
                                   BackgroundColor="Transparent"
                                   FontSize="16" />
                        </Frame>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Date and Time Information -->
            <Frame BackgroundColor="White" 
                   CornerRadius="15" 
                   HasShadow="True"
                   Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="🕒 Fecha y Hora"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#34495E" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="10">
                            <Label Text="Fecha" 
                                   FontSize="14" 
                                   TextColor="#7F8C8D"
                                   FontAttributes="Bold" />
                            <Frame BackgroundColor="#F8F9FA" 
                                   CornerRadius="10" 
                                   Padding="10"
                                   HasShadow="False">
                                <DatePicker x:Name="FechaPicker"
                                           Date="{x:Static sys:DateTime.Today}"
                                           TextColor="#2C3E50"
                                           BackgroundColor="Transparent"
                                           FontSize="16" />
                            </Frame>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="10">
                            <Label Text="Hora" 
                                   FontSize="14" 
                                   TextColor="#7F8C8D"
                                   FontAttributes="Bold" />
                            <Frame BackgroundColor="#F8F9FA" 
                                   CornerRadius="10" 
                                   Padding="10"
                                   HasShadow="False">
                                <TimePicker x:Name="HoraPicker"
                                           Time="08:00:00"
                                           TextColor="#2C3E50"
                                           BackgroundColor="Transparent"
                                           FontSize="16" />
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Trip Details -->
            <Frame BackgroundColor="White" 
                   CornerRadius="15" 
                   HasShadow="True"
                   Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="💰 Detalles del Viaje"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#34495E" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="10">
                            <Label Text="Precio (USD)" 
                                   FontSize="14" 
                                   TextColor="#7F8C8D"
                                   FontAttributes="Bold" />
                            <Frame BackgroundColor="#F8F9FA" 
                                   CornerRadius="10" 
                                   Padding="0"
                                   HasShadow="False">
                                <Entry x:Name="PrecioEntry"
                                       Placeholder="0.00"
                                       Keyboard="Numeric"
                                       TextColor="#2C3E50"
                                       BackgroundColor="Transparent"
                                       FontSize="16" />
                            </Frame>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="10">
                            <Label Text="Asientos" 
                                   FontSize="14" 
                                   TextColor="#7F8C8D"
                                   FontAttributes="Bold" />
                            <Frame BackgroundColor="#F8F9FA" 
                                   CornerRadius="10" 
                                   Padding="0"
                                   HasShadow="False">
                                <Entry x:Name="AsientosEntry"
                                       Placeholder="4"
                                       Keyboard="Numeric"
                                       TextColor="#2C3E50"
                                       BackgroundColor="Transparent"
                                       FontSize="16" />
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Create Button -->
            <Frame BackgroundColor="Transparent" 
                   HasShadow="False"
                   Padding="0"
                   Margin="0,10,0,20">
                <Button Text="🚀 Crear Viaje"
                        BackgroundColor="#E74C3C"
                        TextColor="White"
                        CornerRadius="15"
                        HeightRequest="55"
                        FontSize="18"
                        FontAttributes="Bold"
                        Clicked="OnCreateTripClicked">
                    <Button.Shadow>
                        <Shadow Brush="#E74C3C"
                                Offset="0,4"
                                Radius="8"
                                Opacity="0.3" />
                    </Button.Shadow>
                </Button>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>