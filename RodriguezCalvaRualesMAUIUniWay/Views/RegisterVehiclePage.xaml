<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RodriguezCalvaRualesMAUIUniWay.Views.RegisterVehiclePage"
             Title="{Binding Title}"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Encabezado -->
            <Frame BackgroundColor="#E8F5E8" CornerRadius="15" Padding="20" HasShadow="True">
                <StackLayout Orientation="Horizontal" Spacing="15">
                    <Frame BackgroundColor="#27AE60" CornerRadius="30" WidthRequest="60" HeightRequest="60" Padding="0">
                        <Label Text="🚗" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Registrar Vehículo" FontSize="20" FontAttributes="Bold" TextColor="#27AE60"/>
                        <Label Text="Agrega tu vehículo para ofrecer viajes" FontSize="14" TextColor="#2C3E50"/>
                    </VerticalStackLayout>
                </StackLayout>
            </Frame>

            <!-- Información del Vehículo -->
            <Label Text="📋 Información del Vehículo" FontSize="18" FontAttributes="Bold" TextColor="#2C3E50"/>

            <!-- Marca -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Marca *" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Picker ItemsSource="{Binding MarcasDisponibles}"
                            SelectedItem="{Binding Marca}"
                            Title="Selecciona la marca"
                            TextColor="#2C3E50"
                            TitleColor="#95A5A6"/>
                </Frame>
            </VerticalStackLayout>

            <!-- Modelo -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Modelo *" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Entry Text="{Binding Modelo}"
                           Placeholder="Ej: Corolla, Sentra, etc."
                           PlaceholderColor="#95A5A6"
                           TextColor="#2C3E50"
                           BackgroundColor="Transparent"
                           Margin="15,0"/>
                </Frame>
            </VerticalStackLayout>

            <!-- Color y Año -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <!-- Color -->
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="Color *" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                    <Frame Style="{StaticResource EntryFrameStyle}">
                        <Picker ItemsSource="{Binding ColoresDisponibles}"
                                SelectedItem="{Binding Color}"
                                Title="Color"
                                TextColor="#2C3E50"
                                TitleColor="#95A5A6"/>
                    </Frame>
                </VerticalStackLayout>

                <!-- Año -->
                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="Año *" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                    <Frame Style="{StaticResource EntryFrameStyle}">
                        <Picker ItemsSource="{Binding AñosDisponibles}"
                                SelectedItem="{Binding Año}"
                                Title="Año"
                                TextColor="#2C3E50"
                                TitleColor="#95A5A6"/>
                    </Frame>
                </VerticalStackLayout>
            </Grid>

            <!-- Placa -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Placa *" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Entry Text="{Binding Placa}"
                           Placeholder="Ej: ABC-1234"
                           PlaceholderColor="#95A5A6"
                           TextColor="#2C3E50"
                           BackgroundColor="Transparent"
                           MaxLength="8"
                           Keyboard="Default"
                           Margin="15,0"/>
                </Frame>
                <Label Text="💡 Formato ecuatoriano: ABC-1234 o AB-1234" 
                       FontSize="12" 
                       TextColor="#7F8C8D"/>
            </VerticalStackLayout>

            <!-- Tipo de Vehículo y Capacidad -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <!-- Tipo -->
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="Tipo" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                    <Frame Style="{StaticResource EntryFrameStyle}">
                        <Picker ItemsSource="{Binding TiposVehiculo}"
                                SelectedItem="{Binding TipoVehiculo}"
                                Title="Tipo"
                                TextColor="#2C3E50"
                                TitleColor="#95A5A6"/>
                    </Frame>
                </VerticalStackLayout>

                <!-- Capacidad -->
                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="Capacidad *" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                    <Frame Style="{StaticResource EntryFrameStyle}">
                        <Picker ItemsSource="{Binding CapacidadesDisponibles}"
                                SelectedItem="{Binding Capacidad}"
                                Title="Pasajeros"
                                TextColor="#2C3E50"
                                TitleColor="#95A5A6"/>
                    </Frame>
                </VerticalStackLayout>
            </Grid>

            <!-- Información Importante -->
            <Frame BackgroundColor="#FFF9E6" CornerRadius="10" Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="ℹ️ Información Importante" FontSize="16" FontAttributes="Bold" TextColor="#F39C12"/>
                    <Label Text="• Solo los conductores registrados pueden agregar vehículos" FontSize="13" TextColor="#2C3E50"/>
                    <Label Text="• La placa debe ser única en el sistema" FontSize="13" TextColor="#2C3E50"/>
                    <Label Text="• Puedes registrar múltiples vehículos" FontSize="13" TextColor="#2C3E50"/>
                    <Label Text="• La información será verificada por seguridad" FontSize="13" TextColor="#2C3E50"/>
                </StackLayout>
            </Frame>

            <!-- Botones de Acción -->
            <VerticalStackLayout Spacing="15" Margin="0,20,0,0">
                <!-- Botón Principal -->
                <Button Text="🚗 Registrar Vehículo"
                        Command="{Binding RegisterVehicleCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        Style="{StaticResource PrimaryButtonStyle}"/>

                <!-- Botones Secundarios -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="🗑️ Limpiar"
                            Command="{Binding ClearFormCommand}"
                            BackgroundColor="#95A5A6"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="45"
                            FontSize="14"/>

                    <Button Grid.Column="1"
                            Text="❌ Cancelar"
                            Command="{Binding CancelCommand}"
                            BackgroundColor="#E74C3C"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="45"
                            FontSize="14"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Indicador de carga -->
            <ActivityIndicator IsVisible="{Binding IsBusy}" 
                             IsRunning="{Binding IsBusy}"
                             Color="#8B0000"
                             VerticalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
