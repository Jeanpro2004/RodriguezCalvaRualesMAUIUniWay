<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RodriguezCalvaRualesMAUIUniWay.Views.RegisterPage"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <!-- Encabezado -->
            <StackLayout HorizontalOptions="Center" Margin="0,20,0,20">
                <Image Source="uniway_logo.png" 
                       HeightRequest="60" 
                       WidthRequest="60"
                       Aspect="AspectFit"/>
                <Label Text="UniWay" 
                       FontSize="28" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#8B0000"/>
                <Label Text="{Binding Title}" 
                       FontSize="18" 
                       HorizontalOptions="Center"
                       TextColor="#2C3E50"/>
            </StackLayout>

            <!-- Información Personal -->
            <Label Text="Información Personal" 
                   FontSize="16" 
                   FontAttributes="Bold" 
                   TextColor="#2C3E50"/>

            <!-- Nombre Completo -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Nombre Completo *" TextColor="#2C3E50" FontSize="14"/>
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Entry Text="{Binding Nombre}"
                           Placeholder="Ej: Juan Pérez"
                           PlaceholderColor="#95A5A6"
                           TextColor="#2C3E50"
                           BackgroundColor="Transparent"
                           Margin="15,0"/>
                </Frame>
            </VerticalStackLayout>

            <!-- Email Universitario -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Email Universitario *" TextColor="#2C3E50" FontSize="14"/>
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Entry Text="{Binding Email}"
                           Placeholder="nombre@universidad.edu.ec"
                           PlaceholderColor="#95A5A6"
                           TextColor="#2C3E50"
                           BackgroundColor="Transparent"
                           Keyboard="Email"
                           Margin="15,0"/>
                </Frame>
                <Label Text="💡 Solo se aceptan emails universitarios (.edu.ec)" 
                       FontSize="12" 
                       TextColor="#7F8C8D"/>
            </VerticalStackLayout>

            <!-- Número de Teléfono -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Número de Teléfono *" TextColor="#2C3E50" FontSize="14"/>
                <StackLayout Orientation="Horizontal" Spacing="5">
                    <Frame BackgroundColor="#F8F9FA" CornerRadius="10" Padding="0" HasShadow="False" BorderColor="#E0E0E0" WidthRequest="80">
                        <Label Text="+593" 
                               TextColor="#2C3E50" 
                               VerticalOptions="Center" 
                               HorizontalOptions="Center"
                               FontSize="16"/>
                    </Frame>
                    <Frame Style="{StaticResource EntryFrameStyle}" HorizontalOptions="FillAndExpand">
                        <Entry Text="{Binding Telefono}"
                               Placeholder="99 123 4567"
                               PlaceholderColor="#95A5A6"
                               TextColor="#2C3E50"
                               BackgroundColor="Transparent"
                               Keyboard="Telephone"
                               MaxLength="9"
                               Margin="15,0"/>
                    </Frame>
                </StackLayout>
            </VerticalStackLayout>

            <!-- ID Banner -->
            <VerticalStackLayout Spacing="5">
                <Label Text="ID Banner *" TextColor="#2C3E50" FontSize="14"/>
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Entry Text="{Binding IdBanner}"
                           Placeholder="Ej: B00123456"
                           PlaceholderColor="#95A5A6"
                           TextColor="#2C3E50"
                           BackgroundColor="Transparent"
                           MaxLength="9"
                           Margin="15,0"/>
                </Frame>
                <Label Text="💡 Tu ID Banner universitario (B + 8 dígitos)" 
                       FontSize="12" 
                       TextColor="#7F8C8D"/>
            </VerticalStackLayout>

            <!-- Contraseña -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Contraseña *" TextColor="#2C3E50" FontSize="14"/>
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Entry Text="{Binding Password}"
                           Placeholder="Mínimo 8 caracteres"
                           PlaceholderColor="#95A5A6"
                           TextColor="#2C3E50"
                           BackgroundColor="Transparent"
                           IsPassword="True"
                           Margin="15,0"/>
                </Frame>
            </VerticalStackLayout>

            <!-- Confirmar Contraseña -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Confirmar Contraseña *" TextColor="#2C3E50" FontSize="14"/>
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Entry Text="{Binding ConfirmPassword}"
                           Placeholder="Repite tu contraseña"
                           PlaceholderColor="#95A5A6"
                           TextColor="#2C3E50"
                           BackgroundColor="Transparent"
                           IsPassword="True"
                           Margin="15,0"/>
                </Frame>
            </VerticalStackLayout>

            <!-- Tipo de Usuario -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Tipo de Usuario" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                <Frame BackgroundColor="#F0F8FF" CornerRadius="10" Padding="15">
                    <StackLayout Orientation="Horizontal" Spacing="30">
                        <StackLayout Orientation="Horizontal" Spacing="5">
                            <RadioButton Content="🚶 Pasajero" 
                                        GroupName="UserType" 
                                        IsChecked="{Binding IsDriver, Converter={StaticResource InvertedBoolConverter}}" 
                                        TextColor="#2C3E50"
                                        FontSize="16"/>
                        </StackLayout>
                        <StackLayout Orientation="Horizontal" Spacing="5">
                            <RadioButton Content="🚗 Conductor" 
                                        GroupName="UserType" 
                                        IsChecked="{Binding IsDriver}" 
                                        TextColor="#2C3E50"
                                        FontSize="16"/>
                        </StackLayout>
                    </StackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- Vehículo (solo si es conductor) -->
            <VerticalStackLayout Spacing="5"
                     IsVisible="{Binding IsDriver}">

                <Label Text="Información del Vehículo" 
           FontSize="16" 
           FontAttributes="Bold" 
           TextColor="#2C3E50"/>

                <Label Text="Marca *" TextColor="#2C3E50" FontSize="14"/>
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Entry Text="{Binding Marca}" Placeholder="Toyota, Kia, etc." Margin="15,0"/>
                </Frame>

                <Label Text="Modelo *" TextColor="#2C3E50" FontSize="14"/>
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Entry Text="{Binding Modelo}" Placeholder="Yaris, Río, etc." Margin="15,0"/>
                </Frame>

                <Label Text="Color *" TextColor="#2C3E50" FontSize="14"/>
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Entry Text="{Binding Color}" Placeholder="Rojo, Gris, Azul..." Margin="15,0"/>
                </Frame>

                <Label Text="Placa *" TextColor="#2C3E50" FontSize="14"/>
                <Frame Style="{StaticResource EntryFrameStyle}">
                    <Entry Text="{Binding Placa}" Placeholder="ABC-1234" Margin="15,0"/>
                </Frame>
            </VerticalStackLayout>


            <!-- Términos y Condiciones -->
            <Frame BackgroundColor="#FFF9E6" CornerRadius="10" Padding="15">
                <StackLayout Orientation="Horizontal" Spacing="10">
                    <CheckBox IsChecked="{Binding AcceptTerms}" Color="#8B0000" VerticalOptions="Start"/>
                    <Label TextColor="#2C3E50" FontSize="14" HorizontalOptions="FillAndExpand">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Acepto los "/>
                                <Span Text="términos y condiciones" TextColor="#8B0000" TextDecorations="Underline"/>
                                <Span Text=" y la "/>
                                <Span Text="política de privacidad" TextColor="#8B0000" TextDecorations="Underline"/>
                                <Span Text=" de UniWay"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </StackLayout>
            </Frame>

            <!-- Botón Registro -->
            <Button Text="Crear Mi Cuenta"
                    Command="{Binding RegisterCommand}"
                    IsEnabled="{Binding IsFormValid}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,20,0,0"/> 


            <!-- Link a Login -->
            <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="5" Margin="0,20,0,0">
                <Label Text="¿Ya tienes cuenta?" 
                       TextColor="#2C3E50" 
                       FontSize="14"/>
                <Label Text="Inicia sesión"
                       TextColor="#8B0000"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LoginCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </StackLayout>

            <!-- Indicador de carga -->
            <ActivityIndicator IsVisible="{Binding IsBusy}" 
                             IsRunning="{Binding IsBusy}"
                             Color="#8B0000"
                             VerticalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>