<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RodriguezCalvaRualesMAUIUniWay.Views.MyRidesPage"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Mis Viajes" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#2C3E50"
                   Margin="0,20,0,0" />

            <CollectionView x:Name="MyRidesCollectionView" 
                            SelectionMode="None"
                            Margin="0,10">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#F8F9FA" CornerRadius="10" Padding="15" Margin="0,5" HasShadow="True">
                            <VerticalStackLayout>
                                <Label Text="{Binding Origen}" FontAttributes="Bold" FontSize="16" TextColor="#2C3E50"/>
                                <Label Text="{Binding Destino}" FontSize="14" TextColor="#2C3E50"/>
                                <Label Text="{Binding FechaHoraSalida, StringFormat='dd/MM/yyyy HH:mm'}" FontSize="14" TextColor="#2C3E50"/>
                                <Label Text="{Binding Estado}" FontSize="12" TextColor="#8B0000" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
