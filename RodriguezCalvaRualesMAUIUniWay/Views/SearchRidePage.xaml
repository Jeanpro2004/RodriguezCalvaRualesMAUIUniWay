<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:RodriguezCalvaRualesMAUIUniWay.API"
             x:Class="RodriguezCalvaRualesMAUIUniWay.Views.SearchRidePage"
             Title="Buscar Viajes"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <!-- Título -->
            <Label Text="🔍 Buscar Viaje"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#2C3E50"
                   Margin="0,20,0,0"/>

            <!-- Formulario de búsqueda -->
            <Frame BackgroundColor="#F8F9FA" CornerRadius="15" Padding="20" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <!-- Origen -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Desde" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                        <Frame BackgroundColor="White" CornerRadius="10" Padding="0" HasShadow="False" BorderColor="#E0E0E0">
                            <Entry Text="{Binding Origin}"
                                   Placeholder="¿Desde dónde sales?"
                                   PlaceholderColor="#95A5A6"
                                   TextColor="#2C3E50"
                                   BackgroundColor="Transparent"
                                   Margin="15,0"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Destino -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Hacia" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                        <Frame BackgroundColor="White" CornerRadius="10" Padding="0" HasShadow="False" BorderColor="#E0E0E0">
                            <Entry Text="{Binding Destination}"
                                   Placeholder="¿A dónde vas?"
                                   PlaceholderColor="#95A5A6"
                                   TextColor="#2C3E50"
                                   BackgroundColor="Transparent"
                                   Margin="15,0"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Fecha y Pasajeros -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Fecha" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                            <Frame BackgroundColor="White" CornerRadius="10" Padding="0" HasShadow="False" BorderColor="#E0E0E0">
                                <DatePicker Date="{Binding TravelDate}"
                                           TextColor="#2C3E50"
                                           BackgroundColor="Transparent"
                                           Margin="10,0"
                                           Format="dd/MM/yyyy"/>
                            </Frame>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Pasajeros" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                            <Frame BackgroundColor="White" CornerRadius="10" Padding="0" HasShadow="False" BorderColor="#E0E0E0">
                                <Picker ItemsSource="{Binding PassengerOptions}"
                                        SelectedItem="{Binding SelectedPassengers}"
                                        Title="Selecciona"
                                        TitleColor="#95A5A6"
                                        TextColor="#2C3E50"
                                        BackgroundColor="Transparent"
                                        Margin="10,0"/>
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Botones -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="🔍 Buscar"
                                Command="{Binding SearchCommand}"
                                BackgroundColor="#3498DB"
                                TextColor="White"
                                CornerRadius="25"
                                HeightRequest="45"/>

                        <Button Grid.Column="1"
                                Text="📋 Ver Todos"
                                Command="{Binding LoadViajesCommand}"
                                BackgroundColor="#8B0000"
                                TextColor="White"
                                CornerRadius="25"
                                HeightRequest="45"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Lista de viajes disponibles -->
            <VerticalStackLayout Spacing="10">
                <StackLayout Orientation="Horizontal" Spacing="10">
                    <Label Text="🚌 Viajes Disponibles"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#2C3E50"
                           VerticalOptions="Center"/>

                    <ActivityIndicator IsVisible="{Binding IsBusy}"
                                      IsRunning="{Binding IsBusy}"
                                      Color="#8B0000"
                                      VerticalOptions="Center"/>
                </StackLayout>

                <RefreshView IsRefreshing="{Binding IsBusy}" 
                            Command="{Binding LoadViajesCommand}">
                    <CollectionView ItemsSource="{Binding ViajesDisponibles}">
                        <CollectionView.EmptyView>
                            <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="20">
                                <Label Text="🚌" FontSize="48" HorizontalOptions="Center"/>
                                <Label Text="No hay viajes disponibles" 
                                       FontSize="16" 
                                       TextColor="#7F8C8D"
                                       HorizontalOptions="Center"/>
                            </StackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:Viaje">
                                <Grid Padding="0,5">
                                    <Frame BackgroundColor="White"
                                           CornerRadius="12"
                                           HasShadow="True"
                                           BorderColor="#E0E0E0"
                                           Padding="15">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">

                                            <!-- Ruta -->
                                            <StackLayout Grid.Row="0" Grid.ColumnSpan="2" 
                                                        Orientation="Horizontal" 
                                                        Spacing="8">
                                                <Label Text="🚌" FontSize="16"/>
                                                <Label Text="{Binding Origen}" 
                                                       FontSize="16" 
                                                       FontAttributes="Bold" 
                                                       TextColor="#2C3E50"/>
                                                <Label Text="→" FontSize="16" TextColor="#7F8C8D"/>
                                                <Label Text="{Binding Destino}" 
                                                       FontSize="16" 
                                                       FontAttributes="Bold" 
                                                       TextColor="#2C3E50"/>
                                            </StackLayout>

                                            <!-- Fecha y Hora -->
                                            <StackLayout Grid.Row="1" Grid.Column="0" 
                                                        Orientation="Horizontal" 
                                                        Spacing="5">
                                                <Label Text="📅" FontSize="14"/>
                                                <Label Text="{Binding FechaHoraSalida, StringFormat='{0:dd/MM/yyyy HH:mm}'}" 
                                                       FontSize="14" 
                                                       TextColor="#2C3E50"/>
                                            </StackLayout>

                                            <!-- Precio -->
                                            <StackLayout Grid.Row="1" Grid.Column="1" 
                                                        Orientation="Horizontal" 
                                                        Spacing="5">
                                                <Label Text="💰" FontSize="14"/>
                                                <Label Text="{Binding Precio, StringFormat='${0:F2}'}" 
                                                       FontSize="16" 
                                                       FontAttributes="Bold" 
                                                       TextColor="#27AE60"/>
                                            </StackLayout>

                                            <!-- Asientos disponibles -->
                                            <StackLayout Grid.Row="2" Grid.ColumnSpan="2" 
                                                        Orientation="Horizontal" 
                                                        Spacing="5">
                                                <Label Text="👥" FontSize="14"/>
                                                <Label Text="{Binding AsientosDisponibles, StringFormat='{0} asientos disponibles'}" 
                                                       FontSize="14" 
                                                       TextColor="#2C3E50"/>
                                            </StackLayout>

                                            <!-- Botón Reservar -->
                                            <Button Grid.Row="3" Grid.ColumnSpan="2"
                                                    Text="🎫 Reservar Viaje"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ReservarCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#27AE60"
                                                    TextColor="White"
                                                    CornerRadius="20"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    HeightRequest="40"
                                                    Margin="0,5,0,0"/>
                                        </Grid>
                                    </Frame>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </VerticalStackLayout>

            <!-- Rutas populares -->
            <VerticalStackLayout Spacing="10">
                <Label Text="🔥 Rutas Populares"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#2C3E50"/>

                <CollectionView HeightRequest="100">
                    <CollectionView.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>UDLA PARK → UDLA ARENA</x:String>
                            <x:String>UDLA ARENA → UDLA GRANADOS</x:String>
                            <x:String>UDLA GRANADOS → UDLA COLON</x:String>
                            <x:String>UDLA PARK → UDLA COLON</x:String>
                        </x:Array>
                    </CollectionView.ItemsSource>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="5">
                                <Frame BackgroundColor="#F0F8FF" 
                                       CornerRadius="8" 
                                       Padding="10" 
                                       HasShadow="False">
                                    <Label Text="{Binding .}"
                                           TextColor="#2C3E50"
                                           FontSize="12"
                                           VerticalOptions="Center"/>
                                </Frame>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>