<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RodriguezCalvaRualesMAUIUniWay.Views.SearchRidePage"
             Title="Buscar Viajes"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <!-- Encabezado -->
            <StackLayout HorizontalOptions="Center" Margin="0,20,0,0">
                <Label Text="🔍 Buscar Viaje"
                        FontSize="24"
                        FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#2C3E50"/>
                <Label Text="Encuentra el viaje perfecto para ti"
                        FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="#7F8C8D"/>
            </StackLayout>

            <!-- Formulario de Búsqueda -->
            <Frame Style="{StaticResource CardFrameStyle}" BackgroundColor="#F8F9FA">
                <VerticalStackLayout Spacing="20">
                    <Label Text="📍 Detalles del Viaje"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#2C3E50"
                           HorizontalOptions="Center"/>

                    <!-- Origen -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Desde" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                        <Frame BackgroundColor="White" CornerRadius="10" Padding="0" HasShadow="False" BorderColor="#E0E0E0">
                            <StackLayout Orientation="Horizontal" Spacing="10" Margin="15,0">
                                <Label Text="📍" FontSize="16" VerticalOptions="Center"/>
                                <Entry Text="{Binding Origin}"
                                       Placeholder="¿Desde dónde sales?"
                                       PlaceholderColor="#95A5A6"
                                       TextColor="#2C3E50"
                                       BackgroundColor="Transparent"
                                       HorizontalOptions="FillAndExpand"/>
                            </StackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Destino -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Hacia" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                        <Frame BackgroundColor="White" CornerRadius="10" Padding="0" HasShadow="False" BorderColor="#E0E0E0">
                            <StackLayout Orientation="Horizontal" Spacing="10" Margin="15,0">
                                <Label Text="🎯" FontSize="16" VerticalOptions="Center"/>
                                <Entry Text="{Binding Destination}"
                                       Placeholder="¿A dónde vas?"
                                       PlaceholderColor="#95A5A6"
                                       TextColor="#2C3E50"
                                       BackgroundColor="Transparent"
                                       HorizontalOptions="FillAndExpand"/>
                            </StackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Fecha y Pasajeros en Grid -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                        <!-- Fecha del viaje -->
                        <VerticalStackLayout Grid.Column="0" Spacing="8">
                            <Label Text="📅 Fecha" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                            <Frame BackgroundColor="White" CornerRadius="10" Padding="0" HasShadow="False" BorderColor="#E0E0E0">
                                <DatePicker Date="{Binding TravelDate}"
                                           TextColor="#2C3E50"
                                           BackgroundColor="Transparent"
                                           Margin="10,0"
                                           Format="dd/MM/yyyy"/>
                            </Frame>
                        </VerticalStackLayout>
                        <!-- Número de pasajeros -->
                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="👥 Pasajeros" TextColor="#2C3E50" FontSize="14" FontAttributes="Bold"/>
                            <Frame BackgroundColor="White" CornerRadius="10" Padding="0" HasShadow="False" BorderColor="#E0E0E0">
                                <Picker ItemsSource="{Binding PassengerOptions}"
                                        SelectedItem="{Binding SelectedPassengers}"
                                        Title="Selecciona"
                                        TitleColor="#95A5A6"
                                        TextColor="#2C3E50"
                                        BackgroundColor="Transparent"
                                        Margin="10,0"/>
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Botón de Búsqueda -->
                    <Button Text="🔍 Buscar Viajes Disponibles"
                            Command="{Binding SearchCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Filtros Rápidos -->
            <VerticalStackLayout Spacing="15">
                <Label Text="⚡ Filtros Rápidos"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#2C3E50"/>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Frame BackgroundColor="#E3F2FD" CornerRadius="20" Padding="15,8" HasShadow="False">
                            <Label Text="💰 Económicos" TextColor="#1976D2" FontSize="12" FontAttributes="Bold"/>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FiltroActivo}" CommandParameter="Económicos"/>
                            </Frame.GestureRecognizers>
                        </Frame>
                        <Frame BackgroundColor="#FFF3E0" CornerRadius="20" Padding="15,8" HasShadow="False">
                            <Label Text="🚗 Espaciosos" TextColor="#F57C00" FontSize="12" FontAttributes="Bold"/>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FiltroActivo}" CommandParameter="Espaciosos"/>
                            </Frame.GestureRecognizers>
                        </Frame>
                        <Frame BackgroundColor="#FCE4EC" CornerRadius="20" Padding="15,8" HasShadow="False">
                            <Label Text="⏰ Salida Temprana" TextColor="#C2185B" FontSize="12" FontAttributes="Bold"/>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FiltroActivo}" CommandParameter="Salida Temprana"/>
                            </Frame.GestureRecognizers>
                        </Frame>
                        <Frame BackgroundColor="#E8F5E8" CornerRadius="20" Padding="15,8" HasShadow="False">
                            <Label Text="📋 Todos" TextColor="#388E3C" FontSize="12" FontAttributes="Bold"/>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FiltroActivo}" CommandParameter="Todos"/>
                            </Frame.GestureRecognizers>
                        </Frame>
                    </StackLayout>
                </ScrollView>
            </VerticalStackLayout>

            <!-- Rutas Populares -->
            <VerticalStackLayout Spacing="15">
                <Label Text="🔥 Rutas Populares"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#2C3E50"/>
                <CollectionView ItemsSource="{Binding PopularRoutes}"
                                HeightRequest="120">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="5">
                                <Frame BackgroundColor="#F0F8FF"
                                        CornerRadius="12"
                                        Padding="15"
                                        HasShadow="True"
                                       BorderColor="#E3F2FD">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <!-- Icono de Ruta -->
                                        <Frame Grid.Column="0"
                                                BackgroundColor="#2196F3"
                                                CornerRadius="20"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                Padding="0">
                                            <Label Text="🚌"
                                                    FontSize="20"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"/>
                                        </Frame>
                                        <!-- Información de Ruta -->
                                        <VerticalStackLayout Grid.Column="1"
                                                            VerticalOptions="Center"
                                                            Spacing="2">
                                            <Label Text="{Binding .}"
                                                    TextColor="#2C3E50"
                                                    FontSize="14"
                                                   FontAttributes="Bold"/>
                                            <Label Text="Ruta frecuente • Múltiples horarios"
                                                    TextColor="#7F8C8D"
                                                    FontSize="11"/>
                                        </VerticalStackLayout>
                                        <!-- Botón Seleccionar -->
                                        <Button Grid.Column="2"
                                                Text="Usar"
                                                BackgroundColor="#2196F3"
                                                TextColor="White"
                                                CornerRadius="15"
                                                HeightRequest="30"
                                                WidthRequest="50"
                                                FontSize="11"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RouteSelectedCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </Frame>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Lista de Viajes Disponibles -->
            <VerticalStackLayout Spacing="15" IsVisible="{Binding ViajesDisponibles.Count, Converter={StaticResource CountToBoolConverter}}">
                <Label Text="🚌 Viajes Disponibles"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#2C3E50"/>

                <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadViajesCommand}">
                    <CollectionView ItemsSource="{Binding ViajesDisponibles}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10,5">
                                    <Frame BackgroundColor="White"
                                           CornerRadius="15"
                                           HasShadow="True"
                                           BorderColor="#E0E0E0"
                                           Padding="20">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">

                                            <!-- Ruta -->
                                            <StackLayout Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                                                <Label Text="🚌" FontSize="18"/>
                                                <Label Text="{Binding Origen}" FontSize="16" FontAttributes="Bold" TextColor="#2C3E50"/>
                                                <Label Text="→" FontSize="16" TextColor="#7F8C8D"/>
                                                <Label Text="{Binding Destino}" FontSize="16" FontAttributes="Bold" TextColor="#2C3E50"/>
                                            </StackLayout>

                                            <!-- Fecha y Hora -->
                                            <StackLayout Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                <Label Text="📅" FontSize="14"/>
                                                <Label Text="{Binding FechaHoraSalida, StringFormat='{0:dd/MM/yyyy HH:mm}'}" 
                                                       FontSize="14" TextColor="#2C3E50"/>
                                            </StackLayout>

                                            <!-- Precio -->
                                            <StackLayout Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                                <Label Text="💰" FontSize="14"/>
                                                <Label Text="{Binding Precio, StringFormat='${0:F2}'}" 
                                                       FontSize="16" FontAttributes="Bold" TextColor="#27AE60"/>
                                            </StackLayout>

                                            <!-- Asientos disponibles -->
                                            <StackLayout Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                <Label Text="👥" FontSize="14"/>
                                                <Label Text="{Binding AsientosDisponibles, StringFormat='{0} asientos disponibles'}" 
                                                       FontSize="14" TextColor="#2C3E50"/>
                                            </StackLayout>

                                            <!-- Botón Reservar -->
                                            <Button Grid.Row="3" Grid.ColumnSpan="2"
                                                    Text="🎫 Reservar Viaje"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ReservarCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#27AE60"
                                                    TextColor="White"
                                                    CornerRadius="25"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    HeightRequest="50"
                                                    Margin="0,10,0,0"/>
                                        </Grid>
                                    </Frame>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </VerticalStackLayout>

            <!-- Mensaje cuando no hay viajes -->
            <StackLayout IsVisible="{Binding ViajesDisponibles.Count, Converter={StaticResource CountToInverseBoolConverter}}" 
                         HorizontalOptions="Center" 
                         VerticalOptions="Center"
                         Padding="20">
                <Label Text="🔍" FontSize="48" HorizontalOptions="Center"/>
                <Label Text="No hay viajes disponibles" 
                       FontSize="18" 
                       TextColor="#7F8C8D"
                       HorizontalOptions="Center"/>
                <Label Text="Intenta ajustar tus filtros de búsqueda" 
                       FontSize="14" 
                       TextColor="#95A5A6"
                       HorizontalOptions="Center"/>
            </StackLayout>

            <!-- Indicador de carga -->
            <ActivityIndicator IsVisible="{Binding IsBusy}"
                              IsRunning="{Binding IsBusy}"
                             Color="#2196F3"
                             VerticalOptions="Center"
                             HeightRequest="50"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>